# ElevenLabs: used for both speech-to-text (Scribe realtime) and text-to-speech
ELEVENLABS_API_KEY=
# Optional: any voice id from your ElevenLabs voice library (default: "Sarah")
ELEVENLABS_VOICE_ID=
# Optional: TTS model (default: eleven_flash_v2_5, the low-latency one)
ELEVENLABS_TTS_MODEL=

# Google AI Studio key for Gemini (free tier works)
GOOGLE_API_KEY=
# Optional: override the Gemini model, e.g. a flash / flash-lite model on your free tier
GOOGLE_MODEL=

# Which LLM to use: google (default) or groq
LLM_PROVIDER=
# Groq key from console.groq.com (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=
# Optional: Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=
